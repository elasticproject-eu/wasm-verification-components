package trustee:verifier;

interface snp-host-crypto-interface {
  enum processor-generation {
    milan,
    genoa,
    turin,
  }

  enum vek-kind {
    vcek,
    vlek,
  }

  variant optional-bytes {
    value(list<u8>),
    not-provided,
  }

  record verified-vek-meta {
    vek-kind: vek-kind,
    hw-id: optional-bytes,
    bootloader-spl: u8,
    tee-spl: u8,
    snp-spl: u8,
    microcode-spl: u8,
    fmc-spl: option<u8>,
  }

  verify-snp-crypto: func(
    evidence: list<u8>,
    processor: processor-generation,
    vendor-ark-der: list<u8>,
    vendor-ask-der: list<u8>,
    vendor-asvk-der: list<u8>,
    fetched-vcek-der: optional-bytes,
  ) -> result<verified-vek-meta, string>;
}

interface verifier-interface {
  variant optional-data {
    value(list<u8>),
    not-provided,
  }

  type report-data = optional-data;
  type init-data-hash = optional-data;

  resource verifier {
    constructor();
    evaluate: func(
      evidence: list<u8>,
      expected-report-data: report-data,
      expected-init-data-hash: init-data-hash,
    ) -> string;
  }
}

world verifier {
  import snp-host-crypto-interface;
  export verifier-interface;
}
